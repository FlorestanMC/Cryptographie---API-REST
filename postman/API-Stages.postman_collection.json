      "key": "stageId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Statut 200', () => pm.response.to.have.status(200));",
              "pm.test('status = ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ],
            "type": "text/javascript",
            "id": "f6e8372b-348d-4706-b9e8-64d855543b30"
          }
        }
      ],
      "id": "c5cd27cd-1bf1-45bb-afc7-096f23e54eb7"
    },
    {
      "name": "2. Cr\u00e9er un stage",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/stages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stages"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom_etudiant\": \"Alice Martin\",\n  \"entreprise\": \"Airbus\",\n  \"intitule\": \"D\u00e9veloppeur Backend\",\n  \"date_debut\": \"2026-02-01\",\n  \"date_fin\": \"2026-07-31\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Statut 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Un id est renvoy\u00e9', () => pm.expect(body.id).to.be.a('number'));",
              "pm.test('Donn\u00e9es conformes', () => pm.expect(body.entreprise).to.eql('Airbus'));",
              "pm.collectionVariables.set('stageId', body.id);"
            ],
            "type": "text/javascript",
            "id": "fb4348f7-5ca8-4f94-928f-2c1ca4a93543"
          }
        }
      ],
      "id": "24445821-e942-4644-ab40-e732f01bf861"
    },
